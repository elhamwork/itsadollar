# Stripe TEST (sandbox) secret key — starts with sk_test_
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for the Stripe webhook (api/webhooks/stripe.js)
# https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Auto-filled by Vercel once you add "Postgres" storage to the project.
# Only needed here so `vercel dev` / scripts/migrate.js work locally —
# run `vercel env pull .env.local` to fetch the real value.
POSTGRES_URL=postgres://...

# The password for /admin.html. Pick something long and random.
ADMIN_PASSWORD=

# Random secrets — generate each with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
VOTE_TOKEN_SECRET=

# Brevo API key, for vote-link emails. https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...
# "Name <you@yourdomain.com>" — the address must be a verified sender in
# Brevo (Settings -> Senders, Domains & Dedicated IPs -> Senders) or sends
# will be rejected.
EMAIL_FROM=

# Optional but recommended: a random value Vercel Cron will send back as
# `Authorization: Bearer $CRON_SECRET`, so nobody else can trigger the
# vote-email job. Generate with: openssl rand -hex 32
CRON_SECRET=
